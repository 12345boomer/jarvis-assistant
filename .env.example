# Jarvis secrets. Copy this file to .env, fill in values, never commit .env.
# `make link` symlinks .env into ~/.hermes/.env so Hermes reads it too.
# Lines are grouped by the phase that needs them. Leave later phases blank for now.

# ───────────── Phase 1: brain + Telegram ─────────────

# Anthropic API key. Jarvis's brain (Claude). Create at https://platform.claude.com/settings/keys
# Starts with "sk-ant-". Set a monthly spend limit at https://platform.claude.com/settings/billing
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather (https://t.me/BotFather → /newbot). Looks like 123456789:AAxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user ID (message @userinfobot to get it). Only this ID can talk to Jarvis.
TELEGRAM_ALLOWED_USERS=

# ───────────── Phase 2: long-term memory ─────────────

# Honcho Cloud API key. Long-term memory of who you are across conversations. https://app.honcho.dev → API KEYS
HONCHO_API_KEY=

# ───────────── Phase 3-4: Google Workspace ─────────────

# Google uses two JSON files, not .env lines (both gitignored, both live in ~/.hermes):
#   ~/.hermes/google_client_secret.json  the OAuth "Desktop app" client downloaded from Google Cloud Console
#   ~/.hermes/google_token.json          created by the one-time OAuth flow (skills/google/scripts/setup.py)
# Nothing to paste here. See README "Phase 3".

# ───────────── Phase 5: voice + phone ─────────────

# Hermes's OpenAI-compatible API server (what ElevenLabs's voice agent calls as its "Custom LLM").
# Key is generated locally: openssl rand -hex 24. Never reuse another service's key here.
API_SERVER_ENABLED=true
API_SERVER_KEY=
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642

# Voice bridge (jarvis/voice_bridge.py, launchd ai.jarvis.bridge). Fast model for calls; Hermes hand-offs; background jobs.
VOICE_MODEL=claude-haiku-5-5
HERMES_API_URL=http://127.0.0.1:8644
VOICE_HERMES_TIMEOUT=60      # seconds a call waits on ask_jarvis before giving up out loud
VOICE_TASK_TIMEOUT=1500      # seconds a background job (start_task: decks, research) may run before Telegram gets "ran out of time"
HERMES_BIN=                  # fallback path to the hermes CLI for Telegram delivery (default ~/.local/bin/hermes)

# Public HTTPS address of the API server, from Tailscale Funnel (e.g. https://your-mac.tail1234.ts.net).
# ElevenLabs needs this + the API_SERVER_KEY as the Custom LLM "server URL" and "API key".
JARVIS_PUBLIC_URL=

# ElevenLabs API key. Jarvis's voice (TTS) and the phone/voice agent. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ElevenAgents agent ID (created in the ElevenLabs dashboard in Phase 5).
ELEVENLABS_AGENT_ID=

# ElevenLabs workspace secret holding API_SERVER_KEY (created by scripts/voice_setup.py; the agent uses it to call Jarvis).
ELEVENLABS_SECRET_ID=

# The ID ElevenLabs assigns to your imported Twilio number (Phone numbers tab). Needed for outbound calls.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# ElevenLabs voice ID. British male defaults: George JBFqnCBsd6RMkjVDRZzb, Daniel onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Twilio account SID + a restricted API key/secret (not the master auth token). https://console.twilio.com
TWILIO_ACCOUNT_SID=

# Twilio Auth Token (Console home → Auth Token → Copy). Needed to import the number into ElevenLabs and to verify caller IDs.
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Jarvis's own Twilio number, E.164 (claimed by `make twilio-number`). Ben can call this number to reach Jarvis.
TWILIO_FROM_NUMBER=

# Your mobile number Jarvis calls for urgent things, E.164 format.
BEN_PHONE_NUMBER=

# ───────────── Phase 7: dashboard ─────────────

# Random secret for the local dashboard session. Generate with: openssl rand -hex 32
DASHBOARD_SECRET=

# ───────────── Phase 10: HuskyCT (UConn Blackboard) ─────────────
# Base URL of HuskyCT. Ben signs in once in the Jarvis Browser (make browser); no password is stored anywhere.
HUSKYCT_BASE_URL=https://lms.uconn.edu
# Ben's private calendar-feed URL (all due dates). Filled by `jarvis school setup` after that login; never share it.
HUSKYCT_ICS_URL=
# Where the Jarvis Browser's DevTools port lives (scripts/install_browser.sh). Hermes's browser tool attaches here too.
JARVIS_BROWSER_CDP=http://127.0.0.1:9333
